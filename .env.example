SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=CLOUDSPEND_AI
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_AUTHENTICATOR=
LLM_PROVIDER=none
LLM_API_KEY=
# Key-pair auth (recommended; works with MFA-enforced accounts). Leave PASSWORD empty.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SSO / browser login: set SNOWFLAKE_AUTHENTICATOR=externalbrowser
# Read-only dashboard login (optional; created by sql/08_readonly_role.sql). Falls back to the pipeline login if unset.
SNOWFLAKE_APP_USER=
SNOWFLAKE_APP_ROLE=CLOUDSPEND_READER
SNOWFLAKE_APP_PRIVATE_KEY_PATH=
# CLOUDSPEND_DATA_MODE=local   # force local CSV mode; default: snowflake if configured, else local
# Optional AI wording (off by default). anthropic needs: pip install -e ".[ai]"; sends only computed figures, costs API usage.
# LLM_PROVIDER=gemini | anthropic ; LLM_API_KEY=<key> ; optional LLM_MODEL (gemini default gemini-2.5-flash, anthropic default claude-haiku-4-5-20251001)
